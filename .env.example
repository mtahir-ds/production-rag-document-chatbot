# =============================================================================
# Production RAG Service - Environment Configuration Template
# Copy this file to `.env` and fill in your real values. Never commit `.env`.
# =============================================================================

# --- Application ---
APP_NAME=Production RAG Service
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
APP_DEBUG=false

# --- Google Gemini API ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Qdrant Vector Database ---
# Use QDRANT_MODE=local for embedded persistent storage, or QDRANT_MODE=cloud for Qdrant Cloud
QDRANT_MODE=local
QDRANT_PATH=./qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# --- Local Storage ---
SQLITE_DB_PATH=./data/rag_service.db
UPLOAD_DIR=./uploads

# --- Ingestion & Chunking ---
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=200
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# --- Retrieval & Generation ---
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
MAX_QUESTION_LENGTH=1000
LLM_TEMPERATURE=0.1

# --- Reliability (Timeouts, Retries, Rate Limits) ---
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=2
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_UPLOAD=10/minute

# --- Authentication (JWT - Bonus B1) ---
ENABLE_AUTH=true
JWT_SECRET_KEY=replace-with-a-strong-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
